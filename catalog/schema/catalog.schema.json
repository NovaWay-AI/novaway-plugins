{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitee.com/NovaWay-AI/novaway-plugins/blob/main/catalog/schema/catalog.schema.json",
  "title": "NovaWay Market Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "marketId", "name", "channel", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "marketId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "channel": { "enum": ["stable", "beta", "nightly"] },
    "repository": { "type": "string", "format": "uri" },
    "generatedAt": { "type": ["string", "null"], "format": "date-time" },
    "entries": {
      "type": "array",
      "items": { "$ref": "entry.schema.json" },
      "uniqueItems": true
    }
  }
}
