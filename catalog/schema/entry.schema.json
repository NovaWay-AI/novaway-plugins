{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NovaWay-AI/novaway-plugins/blob/main/catalog/schema/entry.schema.json",
  "title": "NovaWay Market Entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["packageId", "name", "version", "runtimeTargets", "capabilities", "artifacts"],
  "properties": {
    "packageId": { "type": "string", "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "displayNameI18n": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 },
      "minProperties": 1
    },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([+-][0-9A-Za-z.-]+)?$" },
    "description": { "type": "string" },
    "longDescription": { "type": "string" },
    "author": { "type": "string" },
    "icon": { "type": "string" },
    "screenshots": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "categories": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "license": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" },
    "repository": { "type": "string", "format": "uri" },
    "runtimeTargets": { "type": "array", "items": { "enum": ["novaway-v2", "legacy-extension"] }, "minItems": 1, "uniqueItems": true },
    "packageFormats": { "type": "array", "items": { "enum": ["zip", "git", "release"] }, "minItems": 1, "uniqueItems": true },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minNovaWayApi": { "type": "string" },
        "maxNovaWayApi": { "type": "string" },
        "manifestVersion": { "type": "integer", "minimum": 1 },
        "requiresRestart": { "type": "boolean" }
      }
    },
    "capabilities": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "marketTypes": { "type": "array", "items": { "enum": ["workbench", "agents", "skills", "mcp", "tools", "commands", "theme", "other", "providers", "ui", "office", "interceptors"] }, "uniqueItems": true },
    "permissions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "releaseNotes": { "type": "string" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "url", "sha256", "size"],
        "properties": {
          "type": { "enum": ["github-release", "archive", "git"] },
          "url": { "type": "string", "format": "uri" },
          "repository": { "type": "string" },
          "tag": { "type": "string" },
          "asset": { "type": "string" },
          "commitSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "size": { "type": "integer", "minimum": 1 },
          "mirrors": { "type": "array", "items": { "type": "string", "format": "uri" }, "uniqueItems": true }
        }
      }
    }
  }
}
