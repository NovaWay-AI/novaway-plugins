{
  "$schema": "../../catalog/schema/manifest.schema.json",
  "apiVersion": 2,
  "name": "marketplace-capability-smoke",
  "version": "0.3.2",
  "kind": "declarative",
  "description": "Official executable fixture proving all published NovaWay v2 marketplace contributions are usable after installation.",
  "engines": {
    "novaway": ">=0.0.0"
  },
  "categories": [
    "developer-tools",
    "testing"
  ],
  "capabilities": {
    "providers": [
      "capability-provider"
    ],
    "ui": [
      "office-engine"
    ]
  },
  "activationEvents": [
    "onStartup"
  ],
  "contributes": {
    "tools": [
      {
        "id": "capability-echo",
        "description": "Echo text from an installed marketplace plugin.",
        "parameters": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        "entry": "./tools/capability-echo.mjs"
      }
    ],
    "agents": [
      {
        "id": "capability-reviewer",
        "description": "Reviews a request and returns a concise, evidence-based plan.",
        "mode": "subagent",
        "prompt": {
          "file": "./agents/capability-reviewer.md"
        },
        "tools": [
          "marketplace-capability-smoke_capability-echo"
        ]
      }
    ],
    "skills": [
      "./skills"
    ],
    "commands": [
      {
        "id": "capability-plan",
        "description": "Create a plan using the installed capability smoke plugin.",
        "template": "Create a concise implementation plan for $ARGUMENTS",
        "argumentHint": "$ARGUMENTS",
        "agent": "marketplace-capability-smoke_capability-reviewer"
      }
    ],
    "interceptors": "./interceptors.mjs",
    "providers": [
      "./provider.mjs"
    ],
    "officeEngines": [
      {
        "format": "novaway-capability",
        "kind": "plaintext",
        "extensions": [
          ".nvcap"
        ],
        "entry": "./office.mjs"
      }
    ],
    "surfaces": [
      {
        "slot": "sidebar.item",
        "id": "capability-home",
        "title": "Capability Smoke",
        "icon": "archive",
        "action": {
          "type": "url",
          "url": "https://novaway.ai/marketplace/capability-smoke"
        }
      }
    ],
    "previewers": [
      {
        "id": "capability-preview",
        "match": {
          "extension": [
            ".nvcap"
          ]
        },
        "render": {
          "type": "iframe",
          "url": "https://novaway.ai/marketplace/capability-preview"
        },
        "readOnly": true
      }
    ],
    "agentRuntimes": [
      {
        "id": "capability-runtime",
        "version": "1.0.0",
        "runtimeType": "marketplace-smoke",
        "capabilities": [
          "streaming",
          "pause",
          "resume",
          "cancellation"
        ],
        "entry": "./super-agent/runtime.mjs",
        "supports": {
          "streaming": true,
          "pause": true,
          "resume": true,
          "cancellation": true
        }
      }
    ],
    "superAgentStrategies": [
      {
        "id": "capability-strategy",
        "version": "1.0.0",
        "entry": "./super-agent/strategy.mjs",
        "deterministic": true
      }
    ],
    "taskKinds": [
      {
        "id": "capability-task",
        "version": "1.0.0",
        "entry": "./super-agent/task-kind.mjs",
        "capabilities": [
          "planning"
        ]
      }
    ],
    "verifiers": [
      {
        "id": "capability-verifier",
        "version": "1.0.0",
        "entry": "./super-agent/verifier.mjs",
        "kinds": [
          "capability-task"
        ]
      }
    ],
    "repairStrategies": [
      {
        "id": "capability-repair",
        "version": "1.0.0",
        "entry": "./super-agent/repair.mjs",
        "failureKinds": [
          "capability-failure"
        ]
      }
    ],
    "agentTemplates": [
      {
        "id": "capability-template",
        "version": "1.0.0",
        "title": "Capability Template",
        "description": "A real installed Super-Agent template.",
        "goal": "Verify installed marketplace capabilities.",
        "tags": [
          "marketplace",
          "fixture"
        ]
      }
    ],
    "superAgentPolicies": [
      {
        "id": "capability-policy",
        "version": "1.0.0",
        "entry": "./super-agent/policy.mjs",
        "capabilities": [
          "planning"
        ]
      }
    ],
    "superAgentSurfaces": [
      {
        "id": "capability-super-agent-surface",
        "slot": "session.panel",
        "title": "Capability Super-Agent",
        "render": {
          "type": "iframe",
          "url": "https://novaway.ai/marketplace/super-agent-capability"
        }
      }
    ]
  }
}
