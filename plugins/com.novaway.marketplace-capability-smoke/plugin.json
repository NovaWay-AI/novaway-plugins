{
  "$schema": "../../catalog/schema/manifest.schema.json",
  "apiVersion": 2,
  "name": "marketplace-capability-smoke",
  "version": "0.2.2",
  "kind": "declarative",
  "description": "Official executable fixture proving marketplace Agents, Skills, Tools, Commands, Interceptors, Providers, Office, Surfaces and Previewers are usable after installation.",
  "engines": {
    "novaway": ">=0.0.0"
  },
  "categories": [
    "developer-tools",
    "testing"
  ],
  "capabilities": {
    "providers": [
      "capability-provider"
    ],
    "ui": [
      "office-engine"
    ]
  },
  "activationEvents": [
    "onStartup"
  ],
  "contributes": {
    "tools": [
      {
        "id": "capability-echo",
        "description": "Echo text from an installed marketplace plugin.",
        "parameters": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        "entry": "./tools/capability-echo.mjs"
      }
    ],
    "agents": [
      {
        "id": "capability-reviewer",
        "description": "Reviews a request and returns a concise, evidence-based plan.",
        "mode": "subagent",
        "prompt": {
          "file": "./agents/capability-reviewer.md"
        },
        "tools": [
          "marketplace-capability-smoke_capability-echo"
        ]
      }
    ],
    "skills": [
      "./skills"
    ],
    "commands": [
      {
        "id": "capability-plan",
        "description": "Create a plan using the installed capability smoke plugin.",
        "template": "Create a concise implementation plan for $ARGUMENTS",
        "argumentHint": "$ARGUMENTS",
        "agent": "marketplace-capability-smoke_capability-reviewer"
      }
    ],
    "interceptors": "./interceptors.mjs",
    "providers": [
      "./provider.mjs"
    ],
    "officeEngines": [
      {
        "format": "novaway-capability",
        "kind": "plaintext",
        "extensions": [
          ".nvcap"
        ],
        "entry": "./office.mjs"
      }
    ],
    "surfaces": [
      {
        "slot": "sidebar.item",
        "id": "capability-home",
        "title": "Capability Smoke",
        "icon": "archive",
        "action": {
          "type": "url",
          "url": "https://novaway.ai/marketplace/capability-smoke"
        }
      }
    ],
    "previewers": [
      {
        "id": "capability-preview",
        "match": {
          "extension": [
            ".nvcap"
          ]
        },
        "render": {
          "type": "iframe",
          "url": "https://novaway.ai/marketplace/capability-preview"
        },
        "readOnly": true
      }
    ]
  }
}
